---
type Topic = 'essays' | 'daily';

interface Props {
  heading?: string;
  /** Pass an empty string to let the heading stand on its own. */
  blurb?: string;
  /**
   * Fixes what the reader subscribes to. On a section page the choice is
   * already implied by where they are standing, so the picker only appears
   * where both streams are on offer.
   */
  topics?: Topic[];
}

const {
  heading = 'Subscribe',
  blurb = '',
  topics: fixedTopics,
} = Astro.props;

const TOPIC_OPTIONS: { value: Topic; label: string; hint: string }[] = [
  { value: 'essays', label: 'Essays', hint: 'now and then' },
  { value: 'daily', label: 'Daily Insights', hint: 'most days' },
];

const languages = [
  { value: 'en', label: 'English' },
  { value: 'ko', label: '한국어' },
];

const showTopicPicker = !fixedTopics || fixedTopics.length === 0;

// Ids have to stay unique if a page ever renders more than one of these.
const uid = Math.random().toString(36).slice(2, 8);
const emailId = `subscribe-email-${uid}`;
const websiteId = `subscribe-website-${uid}`;
---

<section class="py-8 border-t border-sub/20">
  <h2 class:list={['font-serif text-lg', blurb ? 'mb-1' : 'mb-5']}>{heading}</h2>
  {blurb && <p class="text-sub text-sm mb-5">{blurb}</p>}

  <form data-subscribe-form action="/api/subscribe" method="post" class="flex flex-col gap-5">
    {showTopicPicker ? (
      <fieldset class="flex flex-col gap-2">
        <legend class="font-mono text-xs text-sub mb-2">What to receive</legend>
        {TOPIC_OPTIONS.map((topic) => (
          <label class="flex items-baseline gap-2 cursor-pointer">
            <input type="checkbox" name="topics" value={topic.value} checked class="accent-accent" />
            <span class="font-serif text-base">{topic.label}</span>
            <span class="text-sub text-xs">{topic.hint}</span>
          </label>
        ))}
      </fieldset>
    ) : (
      fixedTopics.map((topic) => <input type="hidden" name="topics" value={topic} />)
    )}

    <fieldset class="flex flex-col gap-2">
      <legend class="font-mono text-xs text-sub mb-2">Language</legend>
      <div class="flex gap-5">
        {languages.map((language, index) => (
          <label class="flex items-baseline gap-2 cursor-pointer">
            <input
              type="radio"
              name="language"
              value={language.value}
              checked={index === 0}
              class="accent-accent"
            />
            <span class="font-serif text-base">{language.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
      <label class="sr-only" for={emailId}>Email address</label>
      <input
        id={emailId}
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class="flex-1 min-w-0 px-3 py-2 font-mono text-sm bg-transparent border border-sub/40 focus:border-accent focus:outline-none transition-colors"
      />

      {/* Bots fill every field they find; this one is hidden from people. */}
      <div class="hidden" aria-hidden="true">
        <label for={websiteId}>Leave this field empty</label>
        <input id={websiteId} type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <button
        type="submit"
        class="px-4 py-2 font-mono text-sm border border-text hover:bg-text hover:text-bg disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
      >
        Subscribe
      </button>
    </div>

    <p data-subscribe-status role="status" aria-live="polite" class="font-mono text-sm text-sub empty:hidden"></p>
  </form>
</section>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-subscribe-form]')) {
    const status = form.querySelector<HTMLParagraphElement>('[data-subscribe-status]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = new FormData(form);
      const topics = data.getAll('topics').map(String);

      if (topics.length === 0) {
        if (status) status.textContent = 'Choose at least one thing to receive.';
        return;
      }

      if (button) button.disabled = true;
      if (status) status.textContent = 'Sending…';

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: data.get('email'),
            website: data.get('website'),
            language: data.get('language'),
            topics,
          }),
        });
        const body = (await response.json().catch(() => ({}))) as { error?: string };

        if (response.ok) {
          form.reset();
          if (status) status.textContent = 'Check your inbox to confirm your subscription.';
        } else if (status) {
          status.textContent = body.error ?? 'Something went wrong. Please try again.';
        }
      } catch {
        if (status) status.textContent = 'Network error. Please try again.';
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
