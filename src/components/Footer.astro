---
import { AUTHOR } from '../lib/seo';

const currentYear = new Date().getFullYear();

const links = [
  { label: 'LinkedIn', href: AUTHOR.linkedin },
  { label: 'GitHub', href: AUTHOR.github },
  { label: 'X', href: AUTHOR.x },
  { label: 'Threads', href: AUTHOR.threads },
  { label: 'Instagram', href: AUTHOR.instagram },
  { label: 'Email', href: AUTHOR.email },
];
---

<footer class="py-8 mt-auto border-t border-sub/20">
  <div class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-sm mb-4">
    {links.map(({ label, href }) => (
      <a
        href={href}
        target={href.startsWith('mailto:') ? undefined : '_blank'}
        rel={href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        class="text-sub hover:text-accent transition-colors"
      >
        {label} ↗
      </a>
    ))}
  </div>

  <p class="font-mono text-xs text-sub">
    © {currentYear} Yoonchul Yi
  </p>
</footer>
