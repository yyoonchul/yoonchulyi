---
import { DEFAULT_DESCRIPTION, SITE_NAME } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  lang?: string;
  ogType?: 'website' | 'article' | 'profile';
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonicalPath,
  image = '/og-image.png',
  lang = 'en',
  ogType = 'website',
  robots,
  jsonLd = [],
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://yoonchulyi.com');
const canonicalUrl = canonicalPath
  ? new URL(canonicalPath, siteUrl)
  : new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(image, siteUrl);
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : [jsonLd];

// Cloudflare Web Analytics, which is where the /admin traffic tab gets its
// numbers.
//
// This is empty on purpose, and empty is the finished state. yoonchulyi.com is
// set to "Enable — the JS snippet will be automatically injected", so
// Cloudflare adds beacon.min.js at the edge on every HTML response it serves a
// browser; the page we build ships no beacon of its own and does not need to.
// Putting a token here would add a second beacon and count every pageview
// twice. It is only worth filling in if the site ever moves to "Enable with JS
// Snippet installation", or off Cloudflare's proxy entirely.
//
// (Curl and other non-browser clients see no beacon — injection skips them.
// That absence is not evidence the beacon is missing; check in a browser.)
//
// The admin pages are left out: they are the one corner of the site whose
// traffic is me looking at the traffic.
const WEB_ANALYTICS_TOKEN: string = '';
const measured =
  WEB_ANALYTICS_TOKEN !== '' && !Astro.url.pathname.startsWith('/admin');
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <meta name="generator" content={Astro.generator} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — Essays`} href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — 글`} href="/rss.ko.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — Daily Insights`} href="/daily-insights/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — 데일리 인사이트`} href="/daily-insights/rss.ko.xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Yoonchul Yi logo and yoonchulyi.com" />
  <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:creator" content="@yiyoonchul" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/로고.png" />
  
  <!-- Google Fonts: Newsreader (Serif) & IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,wght@0,400;0,500;1,400;1,500&display=swap"
    rel="stylesheet"
  />
  
  <title>{title}</title>

  {
    measured && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: WEB_ANALYTICS_TOKEN })}
      />
    )
  }

  {
    jsonLdItems.map((item) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(item)}
      />
    ))
  }
</head>
