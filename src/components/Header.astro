---
export interface HeaderSection {
  label: string;
  path: string;
}

interface Props {
  section?: HeaderSection;
}

const { section } = Astro.props as Props;

const trimSlash = (path: string) => path.replace(/\/+$/, '') || '/';
const current = trimSlash(Astro.url.pathname);
const isSectionIndex = section !== undefined && current === trimSlash(section.path);

// The header line is the page title on the home page ("Yoonchul Yi") and on a
// section index ("Yoonchul Yi / Essays"), so it carries the h1 there. On a
// post the title below does, and this line is a breadcrumb back up the path.
const Wrapper = current === '/' || isSectionIndex ? 'h1' : section ? 'nav' : 'div';
---

{/*
  The header is the way home, plus where you are. The home page lists every
  section, so there is no nav row; the section name sits beside the wordmark
  instead. Same serif as the wordmark, so the line reads as one title, but
  upright, smaller, and muted so the name stays the lead and the page title
  below is never outweighed.
*/}
<header class="py-5 sm:py-8">
  <Wrapper
    aria-label={Wrapper === 'nav' ? 'Breadcrumb' : undefined}
    class="flex min-w-0 items-baseline gap-2"
  >
    <a
      href="/"
      class="font-serif italic text-2xl whitespace-nowrap hover:text-accent transition-colors sm:text-3xl"
    >
      Yoonchul Yi
    </a>
    {section && (
      <>
        <span aria-hidden="true" class="font-serif text-lg text-sub/50 sm:text-xl">/</span>
        {isSectionIndex ? (
          <span aria-current="page" class="whitespace-nowrap font-serif text-lg text-sub sm:text-xl">
            {section.label}
          </span>
        ) : (
          <a
            href={section.path}
            class="whitespace-nowrap font-serif text-lg text-sub hover:text-accent transition-colors sm:text-xl"
          >
            {section.label}
          </a>
        )}
      </>
    )}
  </Wrapper>
</header>
