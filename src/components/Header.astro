---
import { isPathActive } from '../lib/navigation';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Experiences', href: '/experiences' },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog', href: '/blog' },
  { label: 'Daily Insights', href: '/daily-insights' },
];
---

{/*
  Four nav items no longer fit beside the wordmark on a phone: both the name
  and the menu broke across lines. Below `sm` the two stack instead, so each
  stays on one line; from `sm` up this is the original single row.
*/}
<header
  class="flex flex-col gap-2 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-0 sm:py-8"
>
  <a
    href="/"
    class="self-start font-serif italic text-2xl whitespace-nowrap hover:text-accent transition-colors sm:self-auto sm:text-3xl"
  >
    Yoonchul Yi
  </a>
  <nav class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-sm sm:gap-x-6">
    {navItems.map(({ label, href }) => {
      const isActive = isPathActive(pathname, href, { exact: false });
      return (
        <a
          href={href}
          class:list={[
            'transition-colors hover:text-accent pb-1',
            isActive ? 'text-accent border-b border-accent' : 'text-sub',
          ]}
        >
          {label}
        </a>
      );
    })}
  </nav>
</header>
