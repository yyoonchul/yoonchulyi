---
import ProjectList from '../components/ProjectList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  createBreadcrumbSchema,
  createPersonSchema,
} from '../../lib/schema';

const description =
  'Projects by Yoonchul Yi: MaekNote, Mynovel, Storybook4me, Notion templates, and content work.';
---

<BaseLayout
  title="Projects - Yoonchul Yi"
  description={description}
  canonicalPath="/projects/"
  section={{ label: 'Projects', path: '/projects/' }}
  jsonLd={[
    createPersonSchema(),
    createBreadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Projects', path: '/projects/' },
    ]),
  ]}
>
  <main class="py-8">
    <div class="space-y-8">
      <ProjectList />
    </div>
  </main>
</BaseLayout>
