---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Subscription confirmed - Yoonchul Yi"
  description="Your subscription to Yoonchul Yi is confirmed."
  canonicalPath="/subscribe/confirmed/"
  robots="noindex, nofollow"
>
  <section class="py-16">
    <h1 class="font-serif text-2xl mb-3">You're subscribed.</h1>
    <p class="font-serif text-lg leading-relaxed text-text mb-6">
      New essays will land in your inbox. Every email has an unsubscribe link.
    </p>
    <a href="/blog/" class="font-mono text-sm text-sub hover:text-accent transition-colors">
      Read the archive ↗
    </a>
  </section>
</BaseLayout>
