---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Confirmation link problem - Yoonchul Yi"
  description="This confirmation link could not be used."
  canonicalPath="/subscribe/error/"
  robots="noindex, nofollow"
>
  <section class="py-16">
    <h1 class="font-serif text-2xl mb-3">That link didn't work.</h1>
    <p class="font-serif text-lg leading-relaxed text-text mb-6">
      Confirmation links expire after 24 hours. Subscribing again sends a fresh one.
    </p>
    <a href="/blog/" class="font-mono text-sm text-sub hover:text-accent transition-colors">
      Back to the blog ↗
    </a>
  </section>
</BaseLayout>
