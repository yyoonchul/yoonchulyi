---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Nothing here is secret in itself — this is a plain static page, and every
// number arrives later from /api/admin/*. The password gate lives in the
// Worker (`handleAdmin`), which is the only thing standing between the CDN and
// this file. See run_worker_first in wrangler.toml.
//
// Two tabs, two sources: page traffic comes from Cloudflare Web Analytics,
// newsletter numbers from Resend. Each loads on first view, so opening the
// page only pays for the tab you are looking at.
//
// Layout and styling live in AdminLayout and src/styles/admin.css. The short
// version: panels group, mono tabular numbers line up, zebra rows carry the
// eye down a long list, and every grey clears WCAG AA.
---

<AdminLayout title="Admin - Yoonchul Yi">
  <Fragment slot="nav">
    <div class="admin-tabs" role="tablist">
      <button type="button" role="tab" class="admin-tab" data-tab="pages">
        Pages
      </button>
      <button type="button" role="tab" class="admin-tab" data-tab="mail">
        Newsletter
      </button>
    </div>
    <div class="admin-ranges" data-ranges>
      <button type="button" data-range="1d">24h</button>
      <button type="button" data-range="7d">7d</button>
      <button type="button" data-range="30d">30d</button>
    </div>
  </Fragment>

  <div data-panel="pages">
    <div data-body="pages" class="admin-stack"></div>
    <p class="note" data-status="pages">Loading…</p>
  </div>

  <div data-panel="mail">
    <div data-body="mail" class="admin-stack"></div>
    <p class="note" data-status="mail">Loading…</p>
  </div>
</AdminLayout>

<script>
  type TabName = 'pages' | 'mail';

  const refreshButton = document.querySelector('[data-refresh]') as HTMLButtonElement;
  const asOf = document.querySelector('[data-asof]') as HTMLElement;
  const tabButtons = Array.from(
    document.querySelectorAll('[data-tab]'),
  ) as HTMLButtonElement[];
  const rangeButtons = Array.from(
    document.querySelectorAll('[data-range]'),
  ) as HTMLButtonElement[];

  let activeTab: TabName = location.hash === '#mail' ? 'mail' : 'pages';
  let activeRange = '7d';
  const loaded = new Set<TabName>();

  // ---------------------------------------------------------------------
  // Building blocks. textContent everywhere, never innerHTML: paths, referrer
  // hosts, subjects and addresses all arrive from outside.
  // ---------------------------------------------------------------------

  function el(tag: string, className = '', text = ''): HTMLElement {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  /** A titled white panel. Pass no title for a bare band, like the stat strip. */
  function panel(title = '', note = ''): HTMLElement {
    const root = el('div', 'panel');
    if (title) {
      const head = el('div', 'panel-head');
      head.append(el('h2', 'panel-title', title));
      if (note) head.append(el('span', 'panel-note', note));
      root.append(head);
    }
    return root;
  }

  function body(flush = false): HTMLElement {
    return el('div', flush ? 'panel-body flush' : 'panel-body');
  }

  function grid(...panels: HTMLElement[]): HTMLElement {
    const wrapper = el('div', 'admin-grid');
    wrapper.append(...panels);
    return wrapper;
  }

  function failed(title: string, message: string): HTMLElement {
    const root = panel(title);
    const box = body();
    box.append(el('p', 'note bad', message));
    root.append(box);
    return root;
  }

  interface StatOptions {
    note?: string;
    /** Colours the note. */
    noteTone?: 'pos' | 'bad';
    /** Colours the value: red for a problem, grey for a harmless zero. */
    valueTone?: 'bad' | 'zero';
    /** Pairs like "248 / 143" need a step down to fit their cell. */
    small?: boolean;
  }

  function stat(label: string, value: string, options: StatOptions = {}): HTMLElement {
    const item = el('div', 'stat');
    item.append(el('div', 'stat-label', label));

    let valueClass = 'stat-value';
    if (options.small) valueClass += ' sm';
    if (options.valueTone) valueClass += ` ${options.valueTone}`;
    item.append(el('div', valueClass, value));

    if (options.note) {
      const noteClass = options.noteTone ? `stat-note ${options.noteTone}` : 'stat-note';
      item.append(el('div', noteClass, options.note));
    }
    return item;
  }

  /** Four across, or two-by-two when the band shares a row with another panel. */
  function statBand(items: HTMLElement[], two = false): HTMLElement {
    const band = el('div', two ? 'stats two' : 'stats');
    band.append(...items);
    return band;
  }

  interface Bar {
    label: string;
    value: number;
  }

  /**
   * A ranked list. Each bar sits in a track, so a short bar reads as short
   * rather than as missing, and the leader carries the accent at full strength
   * — the bar is proportional to the largest row, not the total, because the
   * useful comparison in a top-ten list is against the leader. The share
   * column is against the total, which is the other question.
   */
  function rankList(
    bars: Bar[],
    share = false,
    empty = 'Nothing yet.',
    track = true,
  ): HTMLElement {
    if (!bars.length) return el('p', 'note', empty);

    const peak = Math.max(...bars.map((bar) => bar.value), 1);
    const total = bars.reduce((sum, bar) => sum + bar.value, 0);

    const table = el('table', 'ranks');
    const tbody = el('tbody');

    for (const [index, bar] of bars.entries()) {
      const line = el('tr');

      const label = el('td', 'r-label', bar.label);
      label.title = bar.label;
      line.append(label);

      if (track) {
        const cell = el('td', 'r-track');
        const rail = el('i');
        const fill = el('b', index === 0 ? 'lead' : '');
        fill.style.width = `${Math.max((bar.value / peak) * 100, 3)}%`;
        rail.append(fill);
        cell.append(rail);
        line.append(cell);
      }

      line.append(el('td', 'r-value', number(bar.value)));
      if (share) {
        line.append(el('td', 'r-share', total ? `${Math.round((bar.value / total) * 100)}%` : '—'));
      }

      tbody.append(line);
    }

    table.append(tbody);
    return table;
  }

  interface Column {
    label: string;
    width?: string;
    right?: boolean;
  }

  function dataTable(columns: Column[], plain = false): { table: HTMLElement; rows: HTMLElement } {
    const table = el('table', plain ? 'data plain' : 'data');
    const head = el('thead');
    const line = el('tr');

    for (const column of columns) {
      const cell = el('th', column.right ? 'r' : '', column.label);
      if (column.width) cell.style.width = column.width;
      line.append(cell);
    }

    head.append(line);
    const rows = el('tbody');
    table.append(head, rows);
    return { table, rows };
  }

  function cell(row: HTMLElement, className: string, text: string): HTMLElement {
    const node = el('td', className, text);
    row.append(node);
    return node;
  }

  function flag(text: string, tone: 'sent' | 'draft' | 'gone'): HTMLElement {
    return el('span', `flag ${tone}`, text);
  }

  function percent(part: number, whole: number): string {
    if (!whole) return '—';
    return `${Math.round((part / whole) * 100)}%`;
  }

  /** One decimal, because 99.2% and 100% are a meaningful distance apart. */
  function rate(part: number, whole: number): string {
    if (!whole) return '—';
    return `${((part / whole) * 100).toFixed(1)}%`;
  }

  function shortDate(value: string): string {
    if (!value) return '—';
    // Resend returns "2026-08-23 01:02:03.456+00"; the date is the useful part.
    return value.slice(0, 10);
  }

  function number(value: number): string {
    return (value ?? 0).toLocaleString();
  }

  // ---------------------------------------------------------------------
  // Pages tab — Cloudflare Web Analytics
  // ---------------------------------------------------------------------

  /**
   * What is actually missing, and only that.
   *
   * The old version of this listed four steps for every failure, and the second
   * one told you to paste a beacon token into BaseHead.astro. That is a trap:
   * yoonchulyi.com runs Web Analytics on automatic injection, so Cloudflare
   * already adds the beacon at the edge, and a second one would count every
   * pageview twice. Collection and reading are separate problems; this panel is
   * only ever about the reading half.
   */
  function setupNotice(reason: string, missing: string[]): HTMLElement {
    const root = panel('Not configured yet');
    const box = body();
    box.append(el('p', 'note', reason));

    const steps = el('ol', 'steps');
    if (missing.includes('CF_ACCOUNT_ID')) {
      steps.append(
        el('li', '', 'Set CF_ACCOUNT_ID under [vars] in wrangler.toml, then deploy.'),
      );
    }
    if (missing.includes('CF_ANALYTICS_TOKEN')) {
      for (const step of [
        'Create a Cloudflare API token scoped to Account · Account Analytics · Read.',
        'From the repo root, run: wrangler secret put CF_ANALYTICS_TOKEN',
        'Reload this page. A secret takes effect immediately — no deploy needed.',
      ]) {
        steps.append(el('li', '', step));
      }
    }
    box.append(steps);

    box.append(
      el(
        'p',
        'note',
        'Collection is a separate thing and is already running: Cloudflare injects the ' +
          'beacon at the edge for yoonchulyi.com. WEB_ANALYTICS_TOKEN in BaseHead.astro ' +
          'stays empty on purpose — filling it in puts a second beacon on every page and ' +
          'counts every view twice.',
      ),
    );

    root.append(box);
    return root;
  }

  function axisLabel(label: string, hourly: boolean): string {
    return hourly ? label.slice(11, 16) : label.slice(5);
  }

  /**
   * The trend. Bars are drawn against the busiest bucket in the window, so the
   * shape is a comparison within the range rather than an absolute scale — a
   * quiet week and a busy one look the same height, which is the point when
   * the question is "which day". The peak value is printed above the chart and
   * quarter gridlines sit behind it, so the height can also be read as a number.
   */
  function trendPanel(series: any): HTMLElement {
    const points: any[] = series?.points ?? [];
    const hourly = series?.granularity === 'hour';
    const root = panel(
      hourly ? 'By hour' : 'By day',
      points.length ? 'hover a bar for the count' : 'no data in this window',
    );
    const box = body();
    if (!points.length) {
      box.append(el('p', 'note', 'Nothing recorded in this window.'));
      root.append(box);
      return root;
    }

    const peak = Math.max(...points.map((point: any) => point.pageviews), 1);

    const wrap = el('div', 'chart-wrap');
    wrap.append(el('div', 'chart-peak', `peak ${number(peak)} views`));

    const chart = el('div', 'chart');
    for (const point of points) {
      const column = el('div', point.pageviews === peak ? 'col peak' : 'col');
      column.title =
        `${axisLabel(point.label, hourly)} · ${point.pageviews} views · ${point.visits} visits`;
      const fill = el('span');
      fill.style.height = `${Math.max((point.pageviews / peak) * 100, 1)}%`;
      column.append(fill);
      chart.append(column);
    }
    wrap.append(chart);
    box.append(wrap);

    // Up to ten buckets get a label each, aligned to their bar. Beyond that the
    // labels would collide, so only the ends are marked.
    const axis = el('div', points.length <= 10 ? 'chart-axis' : 'chart-axis sparse');
    if (points.length <= 10) {
      for (const point of points) {
        axis.append(el('span', '', axisLabel(point.label, hourly)));
      }
    } else {
      axis.append(el('span', '', axisLabel(points[0].label, hourly)));
      axis.append(el('span', '', axisLabel(points[points.length - 1].label, hourly)));
    }
    box.append(axis);

    root.append(box);
    return root;
  }

  /**
   * The busiest bucket in the window, labelled the way the chart under it is:
   * a date when the chart is daily, an hour when it is hourly.
   */
  function busiest(series: any): { label: string; note: string } {
    const points: any[] = series?.points ?? [];
    if (!points.length) return { label: '—', note: '' };

    const peak = points.reduce((best: any, point: any) =>
      point.pageviews > best.pageviews ? point : best,
    );
    const hourly = series.granularity === 'hour';
    return {
      label: hourly ? `${peak.label.slice(11, 13)}:00` : peak.label.slice(5),
      note: `${peak.pageviews} views`,
    };
  }

  function listPanel(title: string, note: string, content: HTMLElement): HTMLElement {
    const root = panel(title, note);
    const isTable = content.tagName === 'TABLE';
    const box = body(isTable);
    box.append(content);
    root.append(box);
    return root;
  }

  function trafficPanels(traffic: any): HTMLElement[] {
    const totals = traffic.totals ?? { pageviews: 0, visits: 0 };
    const peak = busiest(traffic.series);

    const overview = panel();
    overview.append(
      statBand([
        stat('pageviews', number(totals.pageviews)),
        stat('visits', number(totals.visits), { note: 'sessions, not people' }),
        stat(
          'per visit',
          totals.visits ? (totals.pageviews / totals.visits).toFixed(1) : '—',
          { note: 'pages read in a sitting' },
        ),
        stat('busiest', peak.label, { note: peak.note }),
      ]),
    );

    const pages = listPanel(
      'Top pages',
      `${(traffic.pages ?? []).length} listed`,
      rankList(
        (traffic.pages ?? []).map((page: any) => ({
          label: page.label || '/',
          value: page.pageviews,
        })),
        true,
      ),
    );

    const external = traffic.referrers?.external ?? [];
    const sources = listPanel(
      'Sources',
      'where the visit came from',
      rankList(
        [
          { label: 'Direct / typed / own links', value: traffic.referrers?.direct ?? 0 },
          ...external.map((source: any) => ({
            label: source.label,
            value: source.pageviews,
          })),
        ],
        true,
      ),
    );

    const places = listPanel(
      'Countries',
      '',
      rankList(
        (traffic.countries ?? []).map((country: any) => ({
          label: country.label || 'unknown',
          value: country.pageviews,
        })),
        true,
      ),
    );

    const clients = panel('Clients');
    const clientBox = body(true);
    const triple = el('div', 'triple');
    for (const [key, heading] of [
      ['devices', 'device'],
      ['browsers', 'browser'],
      ['systems', 'system'],
    ] as [string, string][]) {
      const column = el('div');
      column.append(el('h4', '', heading));
      // No bars here: three lists share one panel, and at roughly 160px each a
      // bar would eat the label down to one letter. The counts carry the rank.
      column.append(
        rankList(
          (traffic[key] ?? []).map((item: any) => ({
            label: item.label || 'unknown',
            value: item.pageviews,
          })),
          false,
          '—',
          false,
        ),
      );
      triple.append(column);
    }
    clientBox.append(triple);
    clients.append(clientBox);

    return [
      overview,
      trendPanel(traffic.series),
      grid(pages, sources),
      grid(places, clients),
    ];
  }

  async function loadPages(): Promise<void> {
    const status = document.querySelector('[data-status="pages"]') as HTMLElement;
    const target = document.querySelector('[data-body="pages"]') as HTMLElement;
    status.className = 'note';
    status.textContent = 'Loading…';

    const data = await request(`/api/admin/traffic?range=${activeRange}`);
    if (!data) return;

    if (!data.configured) {
      // A Worker older than this page would not send `missing`; the token is the
      // half that is normally absent, so that is the safer thing to assume.
      const missing: string[] = data.missing?.length
        ? data.missing
        : ['CF_ANALYTICS_TOKEN'];
      target.replaceChildren(
        setupNotice(data.reason ?? 'No credentials.', missing),
      );
      status.className = 'note bad';
      status.textContent = 'Cloudflare Web Analytics is not wired up yet.';
      return;
    }
    if (data.traffic?.error) {
      target.replaceChildren(failed('Traffic', data.traffic.error));
      status.className = 'note bad';
      status.textContent = 'Could not read Cloudflare Web Analytics.';
      return;
    }

    target.replaceChildren(...trafficPanels(data.traffic));
    stamp(data.fetched_at);
    status.textContent =
      'Cloudflare Web Analytics · counts browsers that ran the beacon.';
  }

  // ---------------------------------------------------------------------
  // Newsletter tab — Resend
  // ---------------------------------------------------------------------

  const TOPIC_NOTES: Record<string, string> = {
    skipped: 'too many contacts to read topics',
    failed: 'topic lookup failed',
  };

  function subscriberPanel(data: any): HTMLElement {
    const contacts: any[] = data.contacts ?? [];
    const root = panel('Subscribers', `${number(contacts.length)} on file`);
    const languages = data.languages ?? { en: 0, ko: 0, unknown: 0 };
    const topics = data.topics ?? { essays: 0, daily: 0, note: 'skipped' };
    const total = data.total ?? (data.active ?? 0) + (data.unsubscribed ?? 0);

    root.append(
      statBand(
        [
          stat('active', number(data.active)),
          stat('unsubscribed', number(data.unsubscribed), {
            note: total ? `${rate(data.unsubscribed, total)} of all time` : '',
          }),
          stat('en / ko', `${languages.en} / ${languages.ko}`, {
            small: true,
            note: languages.unknown
              ? `${languages.unknown} in neither segment`
              : '0 in neither segment',
          }),
          topics.note === 'ok'
            ? stat('essays / daily', `${topics.essays} / ${topics.daily}`, { small: true })
            : stat('essays / daily', '—', {
                small: true,
                note: TOPIC_NOTES[topics.note] ?? '',
              }),
        ],
        true,
      ),
    );

    if (data.truncated) {
      const box = body();
      box.append(el('p', 'note', 'Contact list was truncated at the page cap.'));
      root.append(box);
    }
    return root;
  }

  function deliveryPanel(data: any): HTMLElement {
    const root = panel('Delivery', 'last 30 days');
    root.append(
      statBand(
        [
          stat('sent', number(data.sent)),
          stat('delivered', number(data.delivered), {
            note: `${rate(data.delivered, data.sent)} of sent`,
            noteTone: 'pos',
          }),
          stat('opened', number(data.opened), {
            note: `${percent(data.opened, data.delivered)} of delivered`,
          }),
          stat('clicked', number(data.clicked), {
            note: `${percent(data.clicked, data.delivered)} of delivered`,
          }),
        ],
        true,
      ),
    );
    return root;
  }

  /**
   * Bounces and complaints used to live inside a grey run-on sentence next to
   * "in flight", which made a spam report look exactly like a healthy queue.
   * They get their own band, and anything above zero is red.
   */
  function problemsPanel(data: any): HTMLElement {
    const root = panel('Problems', 'anything above zero wants a look');
    const tone = (count: number) => (count > 0 ? ('bad' as const) : ('zero' as const));

    root.append(
      statBand([
        stat('bounced', number(data.bounced), {
          valueTone: tone(data.bounced),
          note: data.bounced ? `${rate(data.bounced, data.sent)} of sent` : 'none',
          noteTone: data.bounced ? 'bad' : undefined,
        }),
        stat('complained', number(data.complained), {
          valueTone: tone(data.complained),
          note: data.complained ? 'marked as spam' : 'none',
          noteTone: data.complained ? 'bad' : undefined,
        }),
        stat('failed', number(data.failed), {
          valueTone: tone(data.failed),
          note: data.failed ? 'never left Resend' : 'none',
          noteTone: data.failed ? 'bad' : undefined,
        }),
        stat('in flight', number(data.pending), {
          valueTone: data.pending > 0 ? undefined : 'zero',
          note: data.pending ? 'still sending' : 'nothing pending',
        }),
      ]),
    );
    return root;
  }

  function latestPanel(data: any): HTMLElement {
    const recent: any[] = data.recent ?? [];
    const root = panel('Latest', `${recent.length} most recent`);
    const box = body(true);
    const { table, rows } = dataTable([
      { label: 'date', width: '118px' },
      { label: 'to' },
      { label: 'subject' },
      { label: 'last event', width: '120px', right: true },
    ]);

    for (const email of recent) {
      const line = el('tr');
      cell(line, 'date', shortDate(email.created_at));
      cell(line, 'trunc', email.to ?? '');
      cell(line, 'trunc', email.subject ?? '');
      cell(line, 'r seg', email.last_event ?? '');
      rows.append(line);
    }

    box.append(table);
    root.append(box);
    return root;
  }

  function rawEventsPanel(data: any): HTMLElement {
    const events = Object.entries((data.by_event ?? {}) as Record<string, number>).sort(
      (a, b) => b[1] - a[1],
    );
    const root = panel('Raw last_event', 'diagnostics');
    const content = rankList(
      events.map(([event, count]) => ({ label: event, value: count })),
      false,
      'No events in the window.',
    );
    const box = body(content.tagName === 'TABLE');
    box.append(content);
    root.append(box);

    if (data.truncated) {
      const foot = body();
      foot.append(
        el(
          'p',
          'note',
          'Email list was truncated at the page cap; counts are a floor, not a total.',
        ),
      );
      root.append(foot);
    }
    return root;
  }

  /** One issue's detail, fetched the first time its row is opened and kept. */
  const issueCache = new Map<string, any>();

  function issueDetail(detail: any): HTMLElement {
    const box = el('div', 'detail-box');
    if (detail.error) {
      box.append(el('p', 'note bad', detail.error));
      return box;
    }

    const line = (label: string, value: string) => {
      if (!value) return;
      const item = el('div', 'detail-line');
      item.append(el('span', '', label));
      item.append(el('span', '', value));
      box.append(item);
    };

    line('subject', detail.subject);
    line('from', detail.from);
    line('audience', [detail.segment, detail.topic].filter(Boolean).join(' · '));
    line('preview', detail.preview_text);
    line('created', shortDate(detail.created_at));
    line('scheduled', detail.scheduled_at ? shortDate(detail.scheduled_at) : '');
    line('sent', detail.sent_at ? shortDate(detail.sent_at) : 'not sent');

    if (detail.excerpt) {
      box.append(el('p', 'detail-excerpt', detail.excerpt));
    }
    return box;
  }

  function issuesPanel(data: any): HTMLElement {
    const root = panel(
      'Issues',
      `${data.sent ?? 0} sent of ${data.total ?? 0} · click a row for detail`,
    );
    const issues: any[] = data.issues ?? [];

    if (!issues.length) {
      const box = body();
      box.append(el('p', 'note', 'None yet.'));
      root.append(box);
      return root;
    }

    // The list endpoint carries no segment or topic — those only come back with
    // one issue's detail — so the columns here are the four fields it does
    // return. Audience shows up when a row is opened.
    const box = body(true);
    const { table, rows } = dataTable([
      { label: 'created', width: '118px' },
      { label: 'subject' },
      { label: 'sent', width: '118px' },
      { label: 'status', width: '96px', right: true },
    ]);

    for (const issue of issues) {
      const line = el('tr', 'click');
      cell(line, 'date', shortDate(issue.created_at));
      cell(line, 'trunc', issue.subject || issue.name || '');
      cell(line, 'date', issue.sent_at ? shortDate(issue.sent_at) : '—');
      const status = cell(line, 'r', '');
      status.append(flag(issue.status ?? '—', issue.status === 'sent' ? 'sent' : 'draft'));

      const slot = el('tr', 'detail');
      slot.hidden = true;
      const holder = el('td', 'detail-cell');
      holder.colSpan = 4;
      slot.append(holder);

      line.addEventListener('click', async () => {
        if (!slot.hidden) {
          slot.hidden = true;
          return;
        }
        slot.hidden = false;
        if (!issueCache.has(issue.id)) {
          const box = el('div', 'detail-box');
          box.append(el('p', 'note', 'Loading…'));
          holder.replaceChildren(box);
          const detail = await request(`/api/admin/broadcasts/${issue.id}`);
          if (!detail) return;
          issueCache.set(issue.id, detail);
        }
        holder.replaceChildren(issueDetail(issueCache.get(issue.id)));
      });

      rows.append(line, slot);
    }

    box.append(table);
    root.append(box);

    if (data.truncated) {
      const foot = body();
      foot.append(el('p', 'note', 'Broadcast list was truncated at the page cap.'));
      root.append(foot);
    }
    return root;
  }

  /**
   * The list itself. Filtering happens here rather than upstream because the
   * whole roster already arrived with the counts — a search box that costs a
   * round trip would be slower and would spend the Resend rate limit twice.
   */
  function subscriberList(data: any): HTMLElement {
    const contacts: any[] = data.contacts ?? [];
    const root = panel('Subscriber list', `${number(contacts.length)} on file`);

    const searchBox = body();
    const search = document.createElement('input');
    search.type = 'search';
    search.placeholder = 'Filter by address…';
    search.className = 'filter';
    searchBox.append(search);
    root.append(searchBox);

    const listBox = body(true);
    const { table, rows } = dataTable(
      [
        { label: 'joined', width: '118px' },
        { label: 'address' },
        { label: 'language', width: '130px' },
        { label: 'topics', width: '180px' },
      ],
      true,
    );
    listBox.append(table);
    root.append(listBox);

    const foot = el('p', 'list-foot');
    root.append(foot);

    let limit = 25;

    const draw = () => {
      const needle = search.value.trim().toLowerCase();
      const matches = needle
        ? contacts.filter((contact) => contact.email.toLowerCase().includes(needle))
        : contacts;
      const shown = matches.slice(0, limit);

      rows.replaceChildren();
      for (const contact of shown) {
        const line = el('tr', contact.unsubscribed ? 'off' : '');
        cell(line, 'date', shortDate(contact.created_at));
        cell(line, 'trunc', contact.email);

        const language = cell(
          line,
          'seg',
          contact.language === 'unknown' ? '—' : contact.language,
        );
        if (contact.unsubscribed) {
          language.append(document.createTextNode(' '));
          language.append(flag('gone', 'gone'));
        }

        cell(line, 'seg', contact.topics?.length ? contact.topics.join(' + ') : '—');
        rows.append(line);
      }

      foot.replaceChildren();
      if (!matches.length) {
        foot.textContent = 'No match.';
        return;
      }
      foot.textContent = `Showing ${shown.length} of ${number(matches.length)}. `;
      if (matches.length > shown.length) {
        const more = el('button', '', 'Show more');
        more.addEventListener('click', () => {
          limit += 100;
          draw();
        });
        foot.append(more);
      }
    };

    search.addEventListener('input', () => {
      limit = 25;
      draw();
    });
    draw();
    return root;
  }

  function mailPanels(data: any): HTMLElement[] {
    const subscribers = data.subscribers ?? {};
    const emails = data.emails ?? {};
    const broadcasts = data.broadcasts ?? {};
    const out: HTMLElement[] = [];

    out.push(
      grid(
        subscribers.error
          ? failed('Subscribers', subscribers.error)
          : subscriberPanel(subscribers),
        emails.error ? failed('Delivery', emails.error) : deliveryPanel(emails),
      ),
    );

    if (!emails.error) out.push(problemsPanel(emails));

    out.push(
      broadcasts.error ? failed('Issues', broadcasts.error) : issuesPanel(broadcasts),
    );

    if (!subscribers.error) out.push(subscriberList(subscribers));

    if (!emails.error) {
      if (emails.recent?.length) out.push(latestPanel(emails));
      out.push(rawEventsPanel(emails));
    }

    return out;
  }

  async function loadMail(): Promise<void> {
    const status = document.querySelector('[data-status="mail"]') as HTMLElement;
    const target = document.querySelector('[data-body="mail"]') as HTMLElement;
    status.className = 'note';
    status.textContent = 'Loading…';

    const data = await request('/api/admin/stats');
    if (!data) return;

    issueCache.clear();
    target.replaceChildren(...mailPanels(data));
    stamp(data.fetched_at);
    status.textContent = `Resend · keeps ${data.retention_days} days of delivery history.`;
  }

  // ---------------------------------------------------------------------
  // Plumbing
  // ---------------------------------------------------------------------

  function stamp(fetchedAt: string): void {
    asOf.textContent = fetchedAt ? new Date(fetchedAt).toLocaleString() : '—';
  }

  /**
   * The session is 12 hours; when it lapses, reloading puts the login form
   * back on screen instead of leaving dead buttons here. A null return means
   * the caller has nothing to draw and should stop.
   */
  async function request(path: string): Promise<any | null> {
    try {
      const response = await fetch(path, { cache: 'no-store' });
      if (response.status === 401) {
        location.reload();
        return null;
      }
      if (!response.ok) {
        throw new Error(`Request failed with ${response.status}`);
      }
      return await response.json();
    } catch (cause) {
      const status = document.querySelector(
        `[data-status="${activeTab}"]`,
      ) as HTMLElement;
      status.className = 'note bad';
      status.textContent =
        cause instanceof Error ? cause.message : 'Could not load.';
      return null;
    }
  }

  const loaders: Record<TabName, () => Promise<void>> = {
    pages: loadPages,
    mail: loadMail,
  };

  async function reload(tab: TabName): Promise<void> {
    refreshButton.disabled = true;
    try {
      await loaders[tab]();
      loaded.add(tab);
    } finally {
      refreshButton.disabled = false;
    }
  }

  function paint(): void {
    for (const button of tabButtons) {
      button.setAttribute('aria-selected', String(button.dataset.tab === activeTab));
    }
    for (const name of ['pages', 'mail'] as TabName[]) {
      const node = document.querySelector(`[data-panel="${name}"]`) as HTMLElement;
      node.hidden = name !== activeTab;
    }
    for (const button of rangeButtons) {
      button.setAttribute('aria-pressed', String(button.dataset.range === activeRange));
    }
    // The range only means anything to the traffic tab.
    const ranges = document.querySelector('[data-ranges]') as HTMLElement;
    ranges.style.visibility = activeTab === 'pages' ? 'visible' : 'hidden';
  }

  function show(tab: TabName): void {
    activeTab = tab;
    location.hash = tab;
    paint();
    if (!loaded.has(tab)) void reload(tab);
  }

  for (const button of tabButtons) {
    button.addEventListener('click', () => show(button.dataset.tab as TabName));
  }
  for (const button of rangeButtons) {
    button.addEventListener('click', () => {
      activeRange = button.dataset.range ?? '7d';
      paint();
      void reload('pages');
    });
  }
  refreshButton.addEventListener('click', () => void reload(activeTab));
  window.addEventListener('hashchange', () => {
    const tab: TabName = location.hash === '#mail' ? 'mail' : 'pages';
    if (tab !== activeTab) show(tab);
  });

  paint();
  void reload(activeTab);
</script>
