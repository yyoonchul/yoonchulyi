---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import {
  createPersonSchema,
  createWebsiteSchema,
} from '../lib/schema';
import { DEFAULT_DESCRIPTION } from '../lib/seo';
---

<BaseLayout
  title="Yoonchul Yi"
  description={DEFAULT_DESCRIPTION}
  canonicalPath="/"
  jsonLd={[createWebsiteSchema(), createPersonSchema()]}
>
  <!-- About Section -->
  <section class="py-8">
    <p class="font-serif text-lg leading-relaxed text-text">
      Hi, I'm Yoonchul Yi.
      <br/>
      <a
        href="/about"
        class="text-sub hover:text-accent hover:underline transition-colors"
      >
        more about me...
      </a>
    </p>
  </section>

  <SubscribeForm blurb="Essays, and the articles I read." />
</BaseLayout>
