---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import {
  createPersonSchema,
  createWebsiteSchema,
} from '../lib/schema';
import { AUTHOR, DEFAULT_DESCRIPTION } from '../lib/seo';

const socialLinks = [
  { label: 'LinkedIn', href: AUTHOR.linkedin },
  { label: 'GitHub', href: AUTHOR.github },
  { label: 'X', href: AUTHOR.x },
  { label: 'Threads', href: AUTHOR.threads },
  { label: 'Instagram', href: AUTHOR.instagram },
  { label: 'Email', href: AUTHOR.email },
];
---

<BaseLayout
  title="Yoonchul Yi"
  description={DEFAULT_DESCRIPTION}
  canonicalPath="/"
  jsonLd={[createWebsiteSchema(), createPersonSchema()]}
>
  <!-- About Section -->
  <section class="py-8">
    <p class="font-serif text-lg leading-relaxed text-text">
      Hi, I'm Yoonchul Yi.
      <br/>
      <a
        href="/about"
        class="text-sub hover:text-accent hover:underline transition-colors"
      >
        more about me...
      </a>
    </p>
  </section>

  <SubscribeForm blurb="Essays, and the articles I read." />

  <!-- Social Links: last thing on the page, after the one request to stay -->
  <div class="flex flex-wrap gap-x-4 gap-y-2 py-8 border-t border-sub/20 font-mono text-sm">
    {socialLinks.map(({ label, href }) => {
      const isMail = href.startsWith('mailto:');
      return (
        <a
          href={href}
          target={isMail ? undefined : '_blank'}
          rel={isMail ? undefined : 'noopener noreferrer'}
          class="text-sub hover:text-accent transition-colors"
        >
          {label} ↗
        </a>
      );
    })}
  </div>
</BaseLayout>
