---
import SubscribeForm from '../../components/SubscribeForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EssayList from '../components/EssayList.astro';
import NoteList from '../components/NoteList.astro';
import {
  BLOG_SECTIONS,
  getBlogDescription,
  getBlogHref,
  getBlogPostsByType,
  type BlogPostType,
} from '../lib/blog';
import {
  createBreadcrumbSchema,
  createItemListSchema,
} from '../../lib/schema';

interface Props {
  type: BlogPostType;
}

const { type } = Astro.props as Props;
const section = BLOG_SECTIONS[type];
const posts = await getBlogPostsByType(type);

const pageTitle = `${section.label} by Yoonchul Yi`;
const description =
  type === 'essay'
    ? 'Long-form essays by Yoonchul Yi on AI-native productivity, local-first notes, Claude Code workflows, startups, and personal operating systems.'
    : 'Short notes by Yoonchul Yi: passing thoughts on AI, products, startups, and the things he is building.';
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={section.path}
  section={section}
  jsonLd={[
    createBreadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: section.label, path: section.path },
    ]),
    createItemListSchema(
      pageTitle,
      section.path,
      posts.map((post) => ({
        name: post.data.seoTitle ?? post.data.title,
        path: getBlogHref(post),
        description: getBlogDescription(post),
      })),
    ),
  ]}
>
  <section class="py-8">
    {type === 'note' ? <NoteList notes={posts} /> : <EssayList essays={posts} />}
  </section>

  {/* Notes are not mailed, so only the essays page offers the subscription. */}
  {type === 'essay' && (
    <SubscribeForm
      topics={['essays']}
      heading="Essays by email"
      blurb=""
    />
  )}
</BaseLayout>
